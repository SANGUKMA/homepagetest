# 실제 값은 .env.local 에 넣는다. .env* 는 커밋하지 않는다. (CLAUDE.md §5)

# ─── 사이트 (M2) ──────────────────────────────────────────
# 메타데이터·sitemap 의 기준 URL. 미설정 시 http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ─── Supabase (M1부터 필요) ───────────────────────────────
# 클라이언트 노출 허용 값
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# ─── 스팸 방지 · Turnstile (M2 · 무의존 직접 연동) ──────────
# 둘 다 비어 있으면 위젯을 띄우지 않고 서버 검증도 건너뛴다(로컬 개발용).
# 운영 환경에서는 반드시 설정한다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── 문의 알림 이메일 (M2 · Resend HTTP API 직접 호출) ──────
# 셋 중 하나라도 비면 발송을 건너뛴다(접수 자체는 정상 처리).
RESEND_API_KEY=
INQUIRY_NOTIFY_FROM=
# 수신 주소. 쉼표로 여러 개 지정 가능
INQUIRY_NOTIFY_TO=
