# 실제 값은 .env.local 에 넣는다. .env* 는 커밋하지 않는다. (CLAUDE.md §5)

# ─── Supabase (M1부터 필요) ───────────────────────────────
# 클라이언트 노출 허용 값
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# ─── 스팸 방지 · Turnstile (M2 · 연동 방식 승인 후) ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── 문의 알림 이메일 (M2 · 발송 수단 승인 후) ──────────────
# 발송 수단(Resend 등) 확정 시 키 이름을 맞춰 갱신한다
INQUIRY_NOTIFY_TO=
